config SERVICE_BOOT
	bool "Enable booting"
	default y
	select SERVICE_OPENSBI
        select SERVICE_DDR
	help
                This feature enables support for bootstrapping the U54 application harts. This
                is enabled by default.

menu "Boot Service"
    visible if SERVICE_BOOT

config SERVICE_BOOT_SPI_FLASH_OFFSET
    hex "Copy payload from SPI FLASH at offset"
    default  0x400
    depends on SERVICE_SPI
    help
                This feature specifies the offset in SPI Flash where a boot image is stored.

config SERVICE_BOOT_USE_PAYLOAD
    bool "Use Payload Boot"
    default  n
    depends on SERVICE_BOOT
    help
                This feature enables booting a directly contained payload.

config SERVICE_BOOT_USE_PAYLOAD_IN_FABRIC
    bool "Use Payload in Fabric"
    default  n
    depends on SERVICE_BOOT_USE_PAYLOAD
    help
            This feature enables booting a payload contained in the fabric.

config SERVICE_BOOT_USE_PAYLOAD_IN_FABRIC_ADDRESS
    hex "Payload Fabric Address"
    default  0x400
    depends on SERVICE_BOOT_USE_PAYLOAD_IN_FABRIC
    help
            This feature specifies the address for a payload contained in the fabric.

config SERVICE_BOOT_CUSTOM_FLOW
    bool "Use Custom Boot Flow"
    default  n
    depends on SERVICE_BOOT
    help
                This feature enables custom booting flow where all HARTs
                will jump to same entry point in M-mode.

config SERVICE_BOOT_DDR_TARGET_ADDR
	hex "Target Base address for BOOT to DDR copy"
	default 0x103FC00000
	depends on SERVICE_BOOT
	help
                This feature specifies a scratch address for EMMC/QSPI decompression

config SERVICE_BOOT_MMC_USE_GPT
    bool "Use GPT with MMC"
    default SERVICE_BOOT && SERVICE_MMC && y
	depends on SERVICE_MMC
	help
		If CONFIG_SERVICE_MMC is enabled, then for MMC boots this option enables
                parsing of a GUID Partition Table (GPT) in search of the boot image starting
                sector..

menuconfig BOOT_PARAMS
	bool "Boot Parameters (Bootloader 0)"
	default n
	depends on SERVICE_BOOT && SERVICE_MMC && SERVICE_QSPI && SERVICE_QSPI_INFINEON_S25FL
	help
		If enabled, the HSS builds the Bootloader 0 BSP modules shared
		with the application (boards/<board>/bsp/: Boot Parameters
		record store, Bootloader log and payload MD5 verification) and
		drives the automatic boot from the Boot Parameters: the
		boot_sequence[] entries (MSS eMMC / fabric eMMC / golden QSPI)
		are attempted in order (boot_sequence[0] is a one-shot
		override, cleared once attempted) and boot attempts are
		recorded back into the store (current_try / last_failed /
		last_successful). If the Boot Parameters cannot be read, the
		stock boot flow runs instead.

		Requires the MMC service and the QSPI service with the
		Infineon S25FL driver.

		If disabled, the stock HSS boot flow is used.

		If you do not know what to do here, say N.

config BOOT_PARAMS_MD5_VERIFY
	bool "Verify boot image MD5 before booting"
	default y
	depends on BOOT_PARAMS
	help
		If enabled, each boot image loaded from a boot_sequence[] entry
		is streamed again from its storage and its MD5 digest checked
		against the md5Sum in the HSS image header (written by
		hss-payload-generator). An image that fails is never booted:
		the entry is recorded in last_failed with BOOT_ERR_MD5_VERIFY
		and the next boot_sequence[] entry is tried.

		Verification also requires integrity_check_en in the Boot
		Parameters (enabled by default), so the application can still
		turn it off at run time. It is not applied to the stock boot
		flow used when the Boot Parameters cannot be read.

		If disabled, the MD5 check is not built in and images boot
		unverified; a warning is logged when the Boot Parameters
		request the check.

		If you do not know what to do here, say Y.

# Hidden inverse of BOOT_PARAMS_MD5_VERIFY, which is what the C code tests.
# Kconfig writes no CONFIG_ line for a disabled bool, so a config.h that
# predates BOOT_PARAMS_MD5_VERIFY cannot be told apart from one with it
# disabled. Keying the code off this inverse keeps the MD5 check built in
# for such a stale config.h instead of silently dropping it.
config BOOT_PARAMS_MD5_VERIFY_DISABLED
	def_bool !BOOT_PARAMS_MD5_VERIFY
	depends on BOOT_PARAMS

endmenu
